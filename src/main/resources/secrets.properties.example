# Copy this file to secrets.properties (same folder, git ignored) and fill in the values,
# or provide the matching environment variables (see application.properties).
# Generate strong random values, e.g.: openssl rand -base64 48

spring.datasource.username=
spring.datasource.password=

# Base64 encoded, at least 32 bytes (256 bits) once decoded
spring.app.jwtSecret=

spring.apikey=
spring.apisecret=
spring.admin.key=

spring.recaptcha.siteKey=
spring.recaptcha.api=

spring.mail.username=
spring.mail.password=

spring.sms.auth.username=
spring.sms.auth.password=
spring.sms.password=

spring.uaepass.username=
spring.uaepass.password=

spring.serverkey=
spring.serverpass=
